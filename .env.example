# Copy this file to .env and add your own key. Never send this key to a client.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
PORT=3000
HOST=127.0.0.1
PERSIST_LEADS=false
# Cloudflare Pages notification settings are configured as encrypted secrets/variables,
# not committed to this file. See README.md.
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=LeadPilot AI <onboarding@resend.dev>
# Keychain order system. Configure these in Cloudflare Pages, never in public JavaScript.
ADMIN_API_TOKEN=
CUSTOMER_FROM=
PAYPAL_ME_HANDLE=
